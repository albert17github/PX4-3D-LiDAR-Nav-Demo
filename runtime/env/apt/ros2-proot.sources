# PRoot-compatible equivalent of the official ros2-apt-source entry.  Noble's
# apt cannot use that package's inline key under PRoot, so reference the same
# package-provided keyring explicitly instead.
Types: deb deb-src
URIs: http://packages.ros.org/ros2/ubuntu
Suites: noble
Components: main
Signed-By: /project/env/apt/ros2-archive-keyring.asc
